# Everything generated by generate.py / the steps lands in the repository root as
# a new folder (calabria2_v12, ...). Track only the source folders.
/*/
!/from_scratch_v12/
!/rptha/
!/official_ptha_data/
!/inputs_meshes/
!/examples/

.venv/
__pycache__/
*.pyc
.pytest_cache/

# downloaded on demand (SLAB1.0 rasters, PTHA18 event files, the R session)
from_scratch_v12/data/slab1/*.grd
examples/*/data/gcmt/
examples/*/data/slab1/*.grd
examples/*/data/slab2/*.grd
from_scratch_v12/validation/ptha18_reference/events/
*.RData
official_ptha_data/*/
